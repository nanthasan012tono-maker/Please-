local Colors = {
    Active = Color3.fromRGB(0,110,255),
    Default = Color3.fromRGB(35,35,70),
    Blue = Color3.fromRGB(0,110,255),
    Green = Color3.fromRGB(0,175,75),
    Red = Color3.fromRGB(200,50,50),
    Label = Color3.fromRGB(28,28,55),
}

local function CreateTab(name)
    local t = Instance.new("ScrollingFrame")
    t.Name = name
    t.Size = UDim2.fromScale(1,1)
    t.BackgroundColor3 = Color3.fromRGB(22,22,48)
    t.BackgroundTransparency = 0.35
    t.BorderSizePixel = 0
    t.ScrollBarThickness = 6
    t.ScrollBarImageColor3 = Colors.Active
    t.AutomaticCanvasSize = Enum.AutomaticSize.Y
    t.Visible = false
    t.Parent = Content

    local Pad = Instance.new("UIPadding")
    Pad.PaddingTop = UDim.new(0,10)
    Pad.PaddingBottom = UDim.new(0,15)
    Pad.PaddingLeft = UDim.new(0,10)
    Pad.PaddingRight = UDim.new(0,10)
    Pad.Parent = t

    local Lay = Instance.new("UIListLayout")
    Lay.Padding = UDim.new(0,10)
    Lay.SortOrder = Enum.SortOrder.LayoutOrder
    Lay.Parent = t
    Lay:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        t.CanvasSize = UDim2.new(0,0,0,Lay.AbsoluteContentSize.Y+15)
    end)

    Tabs[name] = t
    return t
end

local Tab_Target = CreateTab("Target")
local Tab_Move = CreateTab("Movement")
local Tab_ESP = CreateTab("ESP")

local function AddTabBtn(text, tab)
    local b = Instance.new("TextButton")
    b.Size = UDim2.fromOffset(52,36)
    b.BackgroundColor3 = Colors.Default
    b.BackgroundTransparency = 0.3
    b.Text = text
    b.TextColor3 = Color3.new(1,1,1)
    b.TextScaled = true
    b.Font = Enum.Font.GothamBold
    b.Parent = TabBar
    Instance.new("UICorner", b).CornerRadius = UDim.new(0,6)

    b.MouseButton1Click:Connect(function()
        for _,v in pairs(Tabs) do v.Visible = false end
        for _,v in pairs(TabBtns) do v.BackgroundColor3 = Colors.Default; v.BackgroundTransparency = 0.3 end
        tab.Visible = true
        b.BackgroundColor3 = Colors.Active
        b.BackgroundTransparency = 0
    end)
    table.insert(TabBtns, b)
    return b
end

AddTabBtn("🎯", Tab_Target)
AddTabBtn("🏃", Tab_Move)
AddTabBtn("👁️", Tab_ESP)

